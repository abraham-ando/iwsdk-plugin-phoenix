    </div>
    <div class="row">
      <p class="name" id="need-label-warmth">Chaleur</p>
      <div class="track"><div class="bar" id="need-bar-warmth"></div></div>
      <p class="val" id="need-val-warmth">—</p>
    </div>
    <div class="row">
      <p class="name" id="need-label-energy">Énergie</p>
      <div class="track"><div class="bar" id="need-bar-energy"></div></div>
