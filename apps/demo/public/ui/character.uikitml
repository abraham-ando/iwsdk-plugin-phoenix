      <button class="step" id="gene-plus-skinTone"><p>+</p></button>
      <p class="note" id="gene-note-skinTone">inerte sur ce rig</p>
    </div>
    <div class="row" id="gene-row-hairTone">
      <p class="name" id="gene-label-hairTone">Cheveux</p>
