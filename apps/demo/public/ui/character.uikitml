      <button class="step" id="gene-minus-eyeScale"><p>−</p></button>
      <div class="track"><div class="bar" id="gene-bar-eyeScale"></div></div>
      <p class="val" id="gene-val-eyeScale">0.50</p>
      <button class="step" id="gene-plus-eyeScale"><p>+</p></button>
      <p class="note" id="gene-note-eyeScale">inerte sur ce rig</p>
    </div>
    <div class="row" id="gene-row-cheekbone">
      <p class="name" id="gene-label-cheekbone">Pommettes</p>
