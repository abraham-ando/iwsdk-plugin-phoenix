      <div class="track"><div class="bar" id="gene-bar-hairTone"></div></div>
      <p class="val" id="gene-val-hairTone">0.50</p>
      <button class="step" id="gene-plus-hairTone"><p>+</p></button>
      <p class="note" id="gene-note-hairTone">inerte sur ce rig</p>
    </div>
    <div class="row" id="gene-row-hairStyle">
      <p class="name" id="gene-label-hairStyle">Coiffure</p>
      <button class="step" id="gene-minus-hairStyle"><p>−</p></button>
