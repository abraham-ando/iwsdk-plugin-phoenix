      <button class="step" id="gene-plus-legLength"><p>+</p></button>
      <p class="note" id="gene-note-legLength">inerte sur ce rig</p>
    </div>
    <div class="row" id="gene-row-torsoLength">
      <p class="name" id="gene-label-torsoLength">Longueur de tronc</p>
      <button class="step" id="gene-minus-torsoLength"><p>−</p></button>
      <div class="track"><div class="bar" id="gene-bar-torsoLength"></div></div>
      <p class="val" id="gene-val-torsoLength">0.50</p>
      <button class="step" id="gene-plus-torsoLength"><p>+</p></button>
      <p class="note" id="gene-note-torsoLength">inerte sur ce rig</p>
    </div>
    <div class="row" id="gene-row-shoulderWidth">
