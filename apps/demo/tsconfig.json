{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@iwsdk/vite-plugin-dev/client"],
    "baseUrl": ".",
    "paths": {
      "@character-three/fixtures/*": ["../../packages/character-three/test/fixtures/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
