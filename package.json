{
  "name": "iwsdk-phoenix-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for @iwsdk/plugin-phoenix (client) and iwsdk_phoenix (Elixir server)",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm --filter @iwsdk/plugin-phoenix build && pnpm --filter @iwsdk/plugin-cardinal-ai build",
    "test": "node scripts/check-single-three.mjs && node scripts/check-cardinal-drift.mjs && node --test 'scripts/__tests__/**/*.test.mjs' && pnpm --filter @iwsdk/plugin-phoenix test && pnpm --filter @iwsdk/plugin-cardinal-ai test",
    "typecheck": "pnpm --filter @iwsdk/plugin-phoenix typecheck && pnpm --filter @iwsdk/plugin-cardinal-ai typecheck",
    "test:ai": "pnpm --filter @iwsdk/plugin-cardinal-ai test",
    "test:server": "cd packages/server && mix test",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "demo": "pnpm build && pnpm --filter @iwsdk/plugin-phoenix-demo dev",
    "demo:build": "pnpm build && pnpm --filter @iwsdk/plugin-phoenix-demo build",
    "demo:typecheck": "pnpm --filter @iwsdk/plugin-phoenix-demo typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
