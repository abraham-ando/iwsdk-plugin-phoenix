    "test:watch": "vitest"
  },
  "peerDependencies": { "@iwsdk/core": ">=0.5.0" },
  "devDependencies": {
    "@iwsdk/core": "0.5.3",
    "@types/node": "^22.20.1",
    "elics": "3.4.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": { "@iwsdk/cardinal-character": "workspace:*" },
  "engines": { "node": ">=20.19.0" }
}
